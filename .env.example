# Database. SQLite for local development; use a postgresql:// URL in production
# (and set provider = "postgresql" in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Public base URL, used in emails, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign the development payment simulator's webhooks and other tokens.
# Generate with: openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string"

# Payment provider: "stub" (development simulator) until a real provider is chosen.
# Planned: "paymongo" or "xendit" — see src/lib/payments/README.md
PAYMENT_PROVIDER="stub"
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""

# Cron endpoint protection (release expired stock reservations).
CRON_SECRET="change-me"

# First admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# Give each seeded product 20 units of DEMO stock so the shop can be tried out.
# Set to 0 (or remove) for a real launch and enter actual counts in Admin › Inventory.
SEED_DEMO_STOCK="1"
